# Base URL of the Memoria backend API.
# In dev, Vite proxies /api to this URL (see vite.config.ts).
# In production, this is the absolute URL of your API.
VITE_API_BASE_URL=/api/v1

# Set to "true" to enable MSW (Mock Service Worker) and run the frontend
# without a real backend. Feature branches declare their own mocked endpoints.
VITE_USE_MOCKS=false

# Logger verbosity. Defaults: info in dev, warn in prod.
# Values: debug | info | warn | error | silent
VITE_LOG_LEVEL=info
